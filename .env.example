# =============================================================================
#  ISP RADIUS MANAGEMENT PANEL — Environment Configuration Template
#  Copy this file to .env and fill in secure values:
#     cp .env.example .env
#
#  Generate secure secrets using:
#     openssl rand -hex 32
#
#  NEVER commit the active .env file to Git or version control!
# =============================================================================

# ---- General / Localization -------------------------------------------------
APP_TIMEZONE=Asia/Kathmandu
LOG_LEVEL=info

# ---- PostgreSQL Database ----------------------------------------------------
# DATABASE_URL: postgresql://radius_user@postgres:5432/radius
POSTGRES_DB=radius
POSTGRES_USER=radius
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_PORT=5432

# ---- Backend REST API -------------------------------------------------------
BACKEND_PORT=4000
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=12h
SESSION_REMEMBER_DAYS=30
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

# Rate Limiting Foundation
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# Data Mode:
#   hybrid (default) - uses live database/RADIUS telemetry where present, demo data elsewhere
#   live             - strict live queries only
#   demo             - demo values
DATA_MODE=hybrid

# ---- Initial Administrator Credentials ---------------------------------------
# Created automatically on first bootstrap if user table is empty.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=System Administrator
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ---- FreeRADIUS AAA Configuration --------------------------------------------
# RADIUS_SECRET: Shared secret between backend and FreeRADIUS daemon
RADIUS_SECRET=CHANGE_ME_RADIUS_SHARED_SECRET
RADIUS_CLIENT_NETWORK=172.28.0.0/16
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
RADIUS_TIMEOUT_MS=2000

# Health check test credentials
RADIUS_HEALTHCHECK_USERNAME=testuser
RADIUS_HEALTHCHECK_PASSWORD=testpassword

# ---- Web & Reverse Proxy Ports -----------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443
FRONTEND_PORT=3000
